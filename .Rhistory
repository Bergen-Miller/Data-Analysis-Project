library(tidyverse)
library(skimr)
load('Temp Data/temp_countyIncomePanel.RData')
load('Temp Data/temp_countyImmigrationData.RData')
countyIncomePanel |> group_by(fips) |> summarize(numYears=n()) |> arrange(numYears) |> view()
countyIncomePanel |> filter(fips==9110) |> view()
