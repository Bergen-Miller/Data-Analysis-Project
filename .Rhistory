log(n1) ~ treat * post + lowTaxDiff + highTaxDiff,
data = df_reg
)
etable(model1)
model1 = feols(
log(n1) ~ treat * post,
data = df_reg
)
etable(model1)
model2 = feols(
log(agi / n1) ~ treat * post,
data = df_reg
)
# Nice output table
etable(model2)
